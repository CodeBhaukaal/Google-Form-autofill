{
  "manifest_version": 3,
  "name": "Google Form Auto Filler",
  "version": "1.0.0",
  "description": "Auto-fill configured answers into a Google Form.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://docs.google.com/forms/*"],
  "action": {
    "default_title": "Form Auto Filler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
